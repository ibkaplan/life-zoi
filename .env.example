# lifeZoi runs in development mode without these variables.
# Filling them in does not turn on authentication. This build does not
# connect to Supabase. See README.md and supabase/schema.sql.

# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The assistant stays in local mock mode. Do not put a provider key in the browser.
# AI_PROVIDER other than mock is refused and does not make a network call.
# AI_MODEL is a label for the one planned economical model. It is not called yet.
# Prices are planning estimates in cents per 1,000 tokens, not a bill.
# AI_PLAN is basic, premium, or advanced. Basic is the default. There is no unlimited plan.
# AI_PROVIDER=mock
# AI_MODEL=gpt-4o-mini
# AI_PLAN=basic
# AI_PROMPT_CENTS_PER_1K=0.015
# AI_COMPLETION_CENTS_PER_1K=0.06
