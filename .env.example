# lifeZoi environment variables
#
# This version runs in local development mode when these are blank.
# Local mode stores entries in the browser only. It does not create accounts
# and it does not provide secure server storage.
#
# Setting the Supabase variables does not turn on remote storage in this
# version. Apply supabase/schema.sql yourself and add a server adapter before
# treating any cloud project as the system of record. Never commit real keys.

# Public Supabase settings. Safe to expose only if you intend to use them
# with Row Level Security. Leave blank for local development mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. There is no AI provider in this version.
# If you add one later, keep the key here and never prefix it with NEXT_PUBLIC_.
# OPENAI_API_KEY=
