# lifeZoi runs without these variables. When both are set, signed-in
# answers are stored with the Supabase anon key and row level security.
# Do not put the service role key in the browser or in a NEXT_PUBLIC variable.

# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The unused development endpoint stays in local mock mode.
# AI_PROVIDER other than mock is refused and does not make a network call.
# AI_MODEL is a label for that endpoint. It is not called.
# Prices are planning estimates in cents per 1,000 tokens, not a bill.
# AI_PLAN is basic, premium, or advanced. Basic is the default. There is no unlimited plan.
# AI_PROVIDER=mock
# AI_MODEL=gpt-4o-mini
# AI_PLAN=basic
# AI_PROMPT_CENTS_PER_1K=0.015
# AI_COMPLETION_CENTS_PER_1K=0.06

# Community moderation. Server-only. Leave this empty in git.
# Used only for POST https://api.openai.com/v1/moderations
# with model omni-moderation-latest. Never name it NEXT_PUBLIC_OPENAI_API_KEY.
# This does not call chat completions and it does not enable billing.
OPENAI_API_KEY=

# Optional server-only key for shared community storage.
# It is not used to read assessment or health rows. Never NEXT_PUBLIC.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional server key for the wellness assistant at /ai-assistant.
# Leave this empty to keep the 50 prepared answers. Do not put the key in the browser
# or in a NEXT_PUBLIC_ variable. The server calls only gemini-3.5-flash-lite
# generateContent on the Gemini API free tier, with no grounding or other paid tools.
GEMINI_API_KEY=
